      "name": "Create Custom Template"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').item.json.body;\nconst selectionType = body.selection_type;\nconst templateName = selectionType === 'existing' ? body.template_name : body.demo_name;\n\nlet result;\nlet success = false;\n\nif (selectionType === 'existing') {\n  const raw = $('Apply Existing Template').item.json;\n  const arr = Array.isArray(raw) ? raw : [raw];\n  const match = arr.find(t => t.template_name === templateName);\n  success = match ? !match.error_type : false;\n  result = match || arr;\n} else {\n  result = $('Create Custom Template').item.json;\n  success = !result.error_type;\n}\n\nreturn {\n  json: {\n    success,\n    selection_type: selectionType,\n    demo_name: templateName,\n    message: success\n      ? `Demo environment ready — \"${templateName}\" has been staged in Atlas.`\n      : `Provisioning failed: ${result?.detail || 'Unknown error'}`,\n    result\n  }\n};\n"
      },
