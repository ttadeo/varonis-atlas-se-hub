        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"template_name\": \"{{ $('Webhook').item.json.body.demo_name }}\",\n  \"template_description\": \"{{ $('Webhook').item.json.body.description }}\",\n  \"llm_firewall_rules\": {{ JSON.stringify($('Webhook').item.json.body.rules) }},\n  \"is_global\": false,\n  \"project_id\": \"{{ $('Webhook').item.json.body.project_id }}\"\n}\n",
